# Firebase web config for the openPlan3D client.
# Copy to .env and fill in from your own Firebase project console.
# These values are public client identifiers: the build inlines them into the
# browser bundle. Restrict the key in the Google Cloud console and enforce access
# with Firebase Security Rules. Leave them blank to run with Firebase disabled.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
