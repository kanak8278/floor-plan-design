{
  "group": "baseline plot + BHK",
  "note": "The canonical plot-based cases everything else builds on. Prompts are written in the voice a Bengaluru homeowner actually uses, including quirks like quoting frontage first and saying 'site' rather than 'plot'.",
  "examples": [
    {
      "id": "base-01",
      "prompt": "I have a 30x40 east facing site in Bengaluru. Need a 3BHK ground floor house.",
      "features": [
        "plot",
        "bhk",
        "facing"
      ],
      "expect": "optimal",
      "truth": {
        "site_kind": "plot",
        "plot_width_ft": 30,
        "plot_depth_ft": 40,
        "road_facing": "east",
        "storeys": 1,
        "rooms": {
          "bedroom": 3
        },
        "rooms_min": {
          "living": 1,
          "kitchen": 1,
          "bathroom": 1
        },
        "coverage_max": 0.75,
        "far_max": 1.75
      }
    },
    {
      "id": "base-02",
      "prompt": "Small budget 2BHK on my 20x30 site. Just the basics, nothing fancy.",
      "features": [
        "plot",
        "bhk",
        "budget"
      ],
      "expect": "optimal",
      "truth": {
        "site_kind": "plot",
        "plot_width_ft": 20,
        "plot_depth_ft": 30,
        "storeys": 1,
        "rooms": {
          "bedroom": 2
        },
        "rooms_min": {
          "living": 1,
          "kitchen": 1,
          "bathroom": 1
        },
