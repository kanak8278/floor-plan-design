{
  "group": "multi-floor, stairs, duplex, terrace",
  "note": "G+1 and G+2 are the norm on Bengaluru plots; BBMP allows stilt+3 at 1200 sqft. Stairs are Stair objects, not rooms. Rental-floor briefs are common and imply a second kitchen, which the plausibility checker must not flag as an error.",
  "examples": [
    {
      "id": "floor-01",
      "prompt": "30x40 east facing. Ground floor for my family 2BHK, first floor 2BHK to rent out. Separate staircase from outside for the tenants.",
      "features": ["plot", "bhk", "multifloor", "stairs", "facing"],
      "expect": "optimal",
      "truth": {"site_kind": "plot", "plot_width_ft": 30, "plot_depth_ft": 40,
                "road_facing": "east", "storeys": 2,
                "rooms_min": {"kitchen": 2, "stair": 1}},
      "source": "authored — two kitchens is correct here; a rule that caps kitchens at one would wrongly reject it"
    },
    {
      "id": "floor-02",
      "prompt": "30x40, G+2. Ground floor parking and one 1BHK, then 2BHK on each of the upper floors.",
      "features": ["plot", "multifloor", "stairs", "parking", "far"],
      "expect": "optimal",
      "truth": {"site_kind": "plot", "plot_width_ft": 30, "plot_depth_ft": 40,
                "storeys": 3, "rooms_min": {"parking": 1, "stair": 1},
                "far_max": 1.75}
    },
    {
      "id": "floor-03",
      "prompt": "40x60 duplex. Living, dining, kitchen and one guest bedroom downstairs, three bedrooms and a family lounge upstairs.",
      "features": ["plot", "bhk", "multifloor", "duplex", "stairs", "hall", "dining"],
      "expect": "optimal",
      "truth": {"site_kind": "plot", "plot_width_ft": 40, "plot_depth_ft": 60,
                "storeys": 2, "rooms": {"bedroom": 4},
                "rooms_min": {"living": 2, "dining": 1, "kitchen": 1, "stair": 1}}
    },
    {
      "id": "floor-04",
      "prompt": "30x50 G+1, 4BHK, and I want an internal open staircase in the living room, not a closed one.",
      "features": ["plot", "bhk", "multifloor", "stairs", "hall"],
      "expect": "optimal",
      "truth": {"site_kind": "plot", "plot_width_ft": 30, "plot_depth_ft": 50,
                "storeys": 2, "rooms": {"bedroom": 4},
                "rooms_min": {"stair": 1, "living": 1}}
    },
    {
