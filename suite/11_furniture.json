{
  "group": "furniture, kitchen layout, irregular plots",
  "note": "Furniture selection is a closed-enum LLM choice; placement is a solver. must_place uses real OpenPlan3D catalogue ids so anything placed renders in the editor's 2D and 3D views. Kitchen work-triangle and Vastu fire/water separation are the hardest placement cases.",
  "examples": [
    {
      "id": "furn-01",
      "prompt": "30x40, 3BHK, fully furnished. Beds with wardrobes, sofa and TV in the living, dining table for six.",
      "features": [
        "plot",
        "bhk",
        "furniture",
        "hall",
        "dining"
      ],
      "expect": "optimal",
      "truth": {
        "site_kind": "plot",
        "plot_width_ft": 30,
        "plot_depth_ft": 40,
        "rooms": {
          "bedroom": 3
        },
        "rooms_min": {
          "living": 1,
          "dining": 1
        },
        "must_place": [
          "bed_queen",
          "wardrobe",
          "sofa",
          "television",
          "dining_table",
          "dining_chair"
        ]
      }
    },
    {
      "id": "furn-02",
      "prompt": "40x60, 3BHK, L shaped modular kitchen with the hob on the outer wall and the sink under the window.",
      "features": [
        "plot",
        "bhk",
        "kitchen_layout",
        "furniture"
      ],
      "expect": "optimal",
      "truth": {
        "site_kind": "plot",
        "plot_width_ft": 40,
        "plot_depth_ft": 60,
        "rooms": {
          "bedroom": 3
        },
        "rooms_min": {
          "kitchen": 1
        },
        "must_place": [
          "counter",
          "stove",
          "sink_k",
          "fridge"
        ]
      }
    },
