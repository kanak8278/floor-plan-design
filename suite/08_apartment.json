{
  "group": "apartment units and area quotes",
  "note": "An apartment unit has NO plot -- inventing one voids every setback, coverage and FAR check, so site_kind must be apartment_unit and plot dims absent. The bound is the quoted area stack. Figures here are taken from real Bengaluru builder plans I ingested.",
  "examples": [
    {
      "id": "apt-01",
      "prompt": "I am buying a 2BHK flat, 1353 sq ft super built up, 873 sq ft carpet. Can you draw the layout with two bedrooms, two toilets, kitchen, utility and two balconies?",
      "features": ["apartment_unit", "area_quote", "bhk", "utility", "balcony", "common_bath"],
      "expect": "optimal",
      "truth": {"site_kind": "apartment_unit", "rooms": {"bedroom": 2},
                "rooms_min": {"bathroom": 2, "kitchen": 1, "utility": 1, "balcony": 2},
                "area_quote_sqft": {"super_builtup_sqft": 1353, "carpet_sqft": 873},
                "storeys": 1, "unit_label": "2BHK 2T"},
      "source": "Brigade Lakecrest TYPE C18, verified: carpet 873 vs my computed 864 sq ft (1% error)"
    },
